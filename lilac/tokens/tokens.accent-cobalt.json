{
  "$description": "Cobalt accent (from the SOFT / SYSTEM study). Opt in with <html data-accent=\"cobalt\">.",
  "color": {
    "primary":       { "$value": "#1556E8" },
    "primary-hover": { "$value": "#0F47CC" },
    "primary-light": { "$value": "#3A76FF" },
    "primary-soft":  { "$value": "#A9C3FF" },
    "primary-wash":  { "$value": "#E7EEFF" },
    "on-wash":       { "$value": "#1243B8" },
    "glow":          { "$value": "rgba(21, 86, 232, 0.42)" },
    "glow-soft":     { "$value": "rgba(21, 86, 232, 0.18)" }
  },
  "shadow": {
    "accent":       { "$value": "inset 0 1px 0 rgba(255, 255, 255, 0.28), 0 2px 6px rgba(21, 86, 232, 0.25), 0 12px 26px -8px rgba(21, 86, 232, 0.5)" },
    "accent-hover": { "$value": "inset 0 1px 0 rgba(255, 255, 255, 0.3), 0 3px 8px rgba(21, 86, 232, 0.3), 0 18px 34px -10px rgba(21, 86, 232, 0.55)" },
    "focus":        { "$value": "0 0 0 3px rgba(21, 86, 232, 0.22)" }
  }
}
