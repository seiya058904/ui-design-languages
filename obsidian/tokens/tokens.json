    "text": {
      "$type": "color",
      "$value": "#C9D1DC",
      "$description": "Body text"
    },
    "text-muted": {
      "$type": "color",
      "$value": "#8B95A5",
      "$description": "Secondary text (5.8:1 on base glass)"
    },
    "text-subtle": {
      "$type": "color",
      "$value": "#6B7586",
      "$description": "Placeholders, axis labels"
    },
    "primary": {
      "$type": "color",
      "$value": "#38BDF8",
      "$description": "Glacier cyan — the one luminous accent"
    },
    "primary-strong": {
      "$type": "color",
      "$value": "#0EA5E9",
