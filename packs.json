      "tokens": [
        "lilac/tokens/tokens.json",
        "lilac/tokens/tokens.accent-cobalt.json"
      ],
      "variants": {
        "accent": [
          "violet",
          "cobalt"
        ]
      },
      "fonts": [
        {
          "family": "Cormorant Garamond",
          "url": "https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&display=swap",
          "license": "OFL-1.1"
        },
        {
          "family": "Manrope",
          "url": "https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&display=swap",
          "license": "OFL-1.1"
        }
      ],
      "pages": {
        "styleguide": "lilac/index.html",
