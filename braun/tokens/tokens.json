    },
    "overlay": {
      "$type": "shadow",
      "$value": "inset 0 1px 0 var(--braun-color-highlight), 0 4px 0 var(--braun-color-skirt), 0 28px 48px -16px rgba(20, 20, 14, 0.38)",
