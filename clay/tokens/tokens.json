    },
    "duration-press": {
      "$type": "duration",
      "$value": "110ms",
      "$description": "Going in: press, check"
    },
    "duration-release": {
      "$type": "duration",
      "$value": "460ms",
      "$description": "Coming back: release, hover settle, pop"
    },
    "easing-press": {
      "$type": "cubicBezier",
      "$value": "cubic-bezier(0.3, 0, 0.5, 1)"
    },
    "easing-release": {
      "$type": "cubicBezier",
      "$value": "cubic-bezier(0.34, 1.56, 0.64, 1)",
      "$description": "Squish: the clay springs back past rest, then settles"
