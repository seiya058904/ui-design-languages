  "shadow": {
    "level-0": {
      "$type": "shadow",
      "$value": "inset 0 0 0 1px var(--braun-color-engrave), 0 1px 0 var(--braun-color-engrave-light), 0 0 0 transparent",
      "$description": "0 mm — flush with the panel, defined only by its seam"
    },
    "level-1": {
      "$type": "shadow",
      "$value": "inset 0 1px 0 var(--braun-color-highlight), 0 1px 0 var(--braun-color-skirt), 0 2px 3px var(--braun-color-shade)",
      "$description": "0.5 mm — low"
    },
    "level-2": {
      "$type": "shadow",
      "$value": "inset 0 1px 0 var(--braun-color-highlight), 0 2px 0 var(--braun-color-skirt), 0 5px 8px -2px var(--braun-color-shade)",
      "$description": "1 mm — mid"
    },
    "level-3": {
      "$type": "shadow",
      "$value": "inset 0 1px 0 var(--braun-color-highlight), 0 4px 0 var(--braun-color-skirt), 0 12px 18px -6px var(--braun-color-shade)",
      "$description": "2 mm — high"
    },
    "well": {
      "$type": "shadow",
      "$value": "inset 0 1px 2px var(--braun-color-shade-deep), inset 0 0 0 1px var(--braun-color-engrave), 0 1px 0 var(--braun-color-engrave-light)",
      "$description": "Sunken bays, switch tracks, fields"
    },
    "key": {
      "$type": "shadow",
      "$value": "inset 0 1px 0 var(--braun-color-highlight), inset 0 -1px 0 rgba(0, 0, 0, 0.05), 0 2px 0 var(--braun-color-skirt), 0 3px 4px -1px var(--braun-color-shade), 0 8px 14px -8px var(--braun-color-shade)",
      "$description": "A keycap at rest: lit top edge, lower lip, 2px skirt, contact and ambient shadow"
    },
    "key-pressed": {
      "$type": "shadow",
      "$value": "inset 0 1px 3px var(--braun-color-shade-deep), inset 0 -1px 0 transparent, 0 0.5px 0 var(--braun-color-skirt), 0 1px 1px -1px var(--braun-color-shade), 0 2px 4px -4px var(--braun-color-shade)",
      "$description": "Bottomed out: the skirt disappears into the panel, the top edge falls into shadow. Same five layers as key, so the press interpolates"
    },
    "key-latched": {
      "$type": "shadow",
      "$value": "inset 0 1px 0 var(--braun-color-highlight), inset 0 -1px 0 rgba(0, 0, 0, 0.05), 0 1px 0 var(--braun-color-skirt), 0 2px 2px -1px var(--braun-color-shade), 0 4px 8px -6px var(--braun-color-shade)",
      "$description": "Latched down (a selected key): half its travel, held"
    },
    "key-primary": {
      "$type": "shadow",
      "$value": "inset 0 1px 0 rgba(255, 255, 255, 0.35), inset 0 -1px 0 rgba(0, 0, 0, 0.08), 0 2px 0 var(--braun-color-primary-skirt), 0 3px 4px -1px var(--braun-color-shade), 0 8px 16px -8px var(--braun-color-primary-glow)"
    },
    "key-primary-pressed": {
      "$type": "shadow",
      "$value": "inset 0 1px 3px rgba(80, 20, 0, 0.45), inset 0 -1px 0 transparent, 0 0.5px 0 var(--braun-color-primary-skirt), 0 1px 1px -1px var(--braun-color-shade), 0 2px 4px -4px var(--braun-color-primary-glow)"
    },
    "key-primary-latched": {
      "$type": "shadow",
      "$value": "inset 0 1px 0 rgba(255, 255, 255, 0.28), inset 0 -1px 0 rgba(0, 0, 0, 0.08), 0 1px 0 var(--braun-color-primary-skirt), 0 2px 2px -1px var(--braun-color-shade), 0 6px 12px -6px var(--braun-color-primary-glow)",
      "$description": "A selected orange key, latched at half travel"
    },
    "key-inverse": {
      "$type": "shadow",
      "$value": "inset 0 1px 0 rgba(255, 255, 255, 0.14), inset 0 -1px 0 rgba(0, 0, 0, 0.3), 0 2px 0 var(--braun-color-inverse-skirt), 0 3px 4px -1px var(--braun-color-shade), 0 8px 14px -8px var(--braun-color-shade-deep)"
    },
    "key-inverse-pressed": {
      "$type": "shadow",
      "$value": "inset 0 1px 3px rgba(0, 0, 0, 0.6), inset 0 -1px 0 transparent, 0 0.5px 0 var(--braun-color-inverse-skirt), 0 1px 1px -1px var(--braun-color-shade), 0 2px 4px -4px var(--braun-color-shade)"
    },
    "knob": {
      "$type": "shadow",
      "$value": "inset 0 2px 1px rgba(255, 255, 255, 0.9), inset 0 -3px 6px rgba(0, 0, 0, 0.12), 0 0 0 1px rgba(0, 0, 0, 0.08), 0 6px 0 -1px var(--braun-color-skirt), 0 16px 24px -8px var(--braun-color-shade-deep)",
      "$description": "Turned aluminium knob standing off the panel"
    },
    "led": {
