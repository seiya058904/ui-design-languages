{
  "$description": "Atelier design tokens — a tactile, precise product UI. Cool frosted panels, one cobalt accent, bold uppercase section titles. Tints are derived with color-mix() from the accent and status colors, so accent, dark theme, density, radius, motion and contrast settings all compose. Build with `node scripts/build-tokens.mjs atelier`.",
  "color": {
    "canvas":         { "$type": "color", "$value": "#EDF1F6", "$description": "Page background" },
    "panel":          { "$type": "color", "$value": "rgba(255, 255, 255, 0.72)", "$description": "Frosted panel fill (used with backdrop blur)" },
    "panel-edge":     { "$type": "color", "$value": "rgba(255, 255, 255, 0.85)", "$description": "Bright rim of frosted panels" },
    "surface":        { "$type": "color", "$value": "#FFFFFF", "$description": "Cards, inputs, raised controls" },
    "surface-sunken": { "$type": "color", "$value": "#F2F5F9", "$description": "Inset areas, tracks, empty states" },
    "border":         { "$type": "color", "$value": "#DCE2EB", "$description": "Default 1px border" },
    "border-strong":  { "$type": "color", "$value": "#C3CDDA", "$description": "Hover / emphasis border" },
    "hairline":       { "$type": "color", "$value": "rgba(28, 35, 51, 0.08)", "$description": "Dividers inside panels" },
    "ink":            { "$type": "color", "$value": "#1B2232", "$description": "Headings, Ink swatch" },
    "text":           { "$type": "color", "$value": "#283143", "$description": "Body text" },
    "text-muted":     { "$type": "color", "$value": "#5B6678", "$description": "Secondary text (≥ 4.5:1)" },
    "text-subtle":    { "$type": "color", "$value": "#8F99AA", "$description": "Placeholders, meta" },
    "primary":        { "$type": "color", "$value": "#2F7BF5", "$description": "Cobalt — the accent" },
    "primary-strong": { "$type": "color", "$value": "#1E62D8", "$description": "Pressed accent" },
    "primary-light":  { "$type": "color", "$value": "#4C91FF", "$description": "Top of accent gradients" },
    "primary-ink":    { "$type": "color", "$value": "#FFFFFF", "$description": "Text on accent" },
    "primary-soft":   { "$type": "color", "$value": "color-mix(in srgb, var(--atelier-color-primary) 14%, var(--atelier-color-surface))", "$description": "Selected nav item, soft badge" },
    "on-soft":        { "$type": "color", "$value": "color-mix(in srgb, var(--atelier-color-primary) 78%, var(--atelier-color-ink))", "$description": "Text on primary-soft" },
    "focus":          { "$type": "color", "$value": "color-mix(in srgb, var(--atelier-color-primary) 30%, transparent)", "$description": "Focus ring" },
    "teal":           { "$type": "color", "$value": "#1FB196", "$description": "Teal swatch, success" },
    "amber":          { "$type": "color", "$value": "#F4A23A", "$description": "Amber swatch, warning" },
    "danger":         { "$type": "color", "$value": "#EA5B5B", "$description": "Destructive" },
    "danger-strong":  { "$type": "color", "$value": "#D24242" },
    "violet":         { "$type": "color", "$value": "#7C4DE8", "$description": "Review tag" },
    "teal-soft":      { "$type": "color", "$value": "color-mix(in srgb, var(--atelier-color-teal) 15%, var(--atelier-color-surface))" },
    "teal-ink":       { "$type": "color", "$value": "color-mix(in srgb, var(--atelier-color-teal) 62%, var(--atelier-color-ink))" },
    "amber-soft":     { "$type": "color", "$value": "color-mix(in srgb, var(--atelier-color-amber) 18%, var(--atelier-color-surface))" },
    "amber-ink":      { "$type": "color", "$value": "color-mix(in srgb, var(--atelier-color-amber) 55%, var(--atelier-color-ink))" },
    "danger-soft":    { "$type": "color", "$value": "color-mix(in srgb, var(--atelier-color-danger) 14%, var(--atelier-color-surface))" },
    "danger-ink":     { "$type": "color", "$value": "color-mix(in srgb, var(--atelier-color-danger) 72%, var(--atelier-color-ink))" },
    "violet-soft":    { "$type": "color", "$value": "color-mix(in srgb, var(--atelier-color-violet) 14%, var(--atelier-color-surface))" },
    "violet-ink":     { "$type": "color", "$value": "color-mix(in srgb, var(--atelier-color-violet) 78%, var(--atelier-color-ink))" },
    "inverse":        { "$type": "color", "$value": "#1E2738", "$description": "Dark toast, preview header" },
    "inverse-text":   { "$type": "color", "$value": "#F1F4F9" },
    "disabled":       { "$type": "color", "$value": "#E2E7EE" },
    "disabled-ink":   { "$type": "color", "$value": "#A1ABBA" },
    "checker":        { "$type": "color", "$value": "#E3E8EF", "$description": "Overlay surface checkerboard" },
    "backdrop":       { "$type": "color", "$value": "rgba(18, 26, 42, 0.36)" },
    "specular":       { "$type": "color", "$value": "rgba(255, 255, 255, 0.95)", "$description": "Light catching the top rim of frosted panels and overlays (fades down the sides)" }
  },
  "font": {
    "family": {
      "sans": { "$type": "fontFamily", "$value": "\"Archivo\", \"Helvetica Neue\", \"Segoe UI\", system-ui, sans-serif" }
    },
    "stretch": {
      "display": { "$type": "dimension", "$value": "112%", "$description": "Semi-expanded caps for titles (Archivo width axis)" }
    },
    "size": {
      "display": { "$type": "dimension", "$value": "40px" },
      "title":   { "$type": "dimension", "$value": "28px" },
      "section": { "$type": "dimension", "$value": "24px" },
      "heading": { "$type": "dimension", "$value": "17px" },
      "body":    { "$type": "dimension", "$value": "15px" },
      "small":   { "$type": "dimension", "$value": "14px" },
      "caption": { "$type": "dimension", "$value": "13px" },
      "kicker":  { "$type": "dimension", "$value": "12px" }
    },
    "weight": {
      "regular":  { "$type": "fontWeight", "$value": "400" },
      "medium":   { "$type": "fontWeight", "$value": "500" },
      "semibold": { "$type": "fontWeight", "$value": "600" },
      "bold":     { "$type": "fontWeight", "$value": "700" },
      "black":    { "$type": "fontWeight", "$value": "800" }
    }
  },
  "space": {
    "1": { "$type": "dimension", "$value": "4px" },
    "2": { "$type": "dimension", "$value": "8px" },
    "3": { "$type": "dimension", "$value": "12px" },
    "4": { "$type": "dimension", "$value": "16px" },
    "5": { "$type": "dimension", "$value": "20px" },
    "6": { "$type": "dimension", "$value": "24px" },
    "8": { "$type": "dimension", "$value": "32px" },
    "panel": { "$type": "dimension", "$value": "24px", "$description": "Panel padding (density-aware)" },
    "gap":   { "$type": "dimension", "$value": "16px", "$description": "Default gap between rows (density-aware)" }
  },
  "radius": {
    "base": { "$type": "dimension", "$value": "16px", "$description": "Drives the whole radius scale; the appearance panel slides it from 8 to 24" },
    "sm":   { "$type": "dimension", "$value": "calc(var(--atelier-radius-base) * 0.5)",  "$description": "8 — checkboxes, pagination" },
    "md":   { "$type": "dimension", "$value": "calc(var(--atelier-radius-base) * 0.75)", "$description": "12 — inputs, cards" },
    "lg":   { "$type": "dimension", "$value": "var(--atelier-radius-base)",              "$description": "16 — panels" },
    "xl":   { "$type": "dimension", "$value": "calc(var(--atelier-radius-base) * 1.5)",  "$description": "24 — dialogs, preview frame" },
    "pill": { "$type": "dimension", "$value": "999px", "$description": "Buttons, tabs, badges, switches" }
  },
  "border": {
    "thin":    { "$type": "dimension", "$value": "1px" },
    "regular": { "$type": "dimension", "$value": "1.5px" },
    "thick":   { "$type": "dimension", "$value": "2px" }
  },
  "size": {
    "control-sm": { "$type": "dimension", "$value": "32px" },
    "control":    { "$type": "dimension", "$value": "40px" },
    "control-lg": { "$type": "dimension", "$value": "48px" },
    "row":        { "$type": "dimension", "$value": "40px", "$description": "Nav items, table rows" }
  },
  "shadow": {
    "subtle":   { "$type": "shadow", "$value": "0 1px 1px rgba(28, 35, 51, 0.04), 0 1px 3px rgba(28, 35, 51, 0.06)" },
    "panel":    { "$type": "shadow", "$value": "inset 0 1px 0 rgba(255, 255, 255, 0.8), 0 1px 2px rgba(28, 35, 51, 0.04), 0 12px 32px -14px rgba(28, 35, 51, 0.16)" },
    "floating": { "$type": "shadow", "$value": "0 4px 10px rgba(28, 35, 51, 0.06), 0 16px 32px -12px rgba(28, 35, 51, 0.22)" },
    "modal":    { "$type": "shadow", "$value": "0 10px 24px rgba(28, 35, 51, 0.1), 0 32px 64px -20px rgba(28, 35, 51, 0.32)" },
    "inset":    { "$type": "shadow", "$value": "inset 0 1px 2px rgba(28, 35, 51, 0.08)" },
    "pressed":  { "$type": "shadow", "$value": "0 1px 1px transparent, 0 1px 3px transparent, inset 0 1px 2px rgba(28, 35, 51, 0.1)", "$description": "Same list shape as subtle (outer, outer) so a press fades the lift into the well" },
    "primary":  { "$type": "shadow", "$value": "inset 0 1px 0 rgba(255, 255, 255, 0.22), 0 1px 2px color-mix(in srgb, var(--atelier-color-primary-strong) 40%, transparent), 0 6px 16px -6px color-mix(in srgb, var(--atelier-color-primary) 65%, transparent)" },
    "focus":    { "$type": "shadow", "$value": "0 0 0 3px var(--atelier-color-focus)" },
    "overlay":  { "$type": "shadow", "$value": "0 0 0 1px rgba(28, 35, 51, 0.05), 0 8px 20px -6px rgba(28, 35, 51, 0.16), 0 28px 60px -18px rgba(28, 35, 51, 0.34)", "$description": "Menus, the command palette and popovers: a crisp contact edge and a deep, soft drop" }
  },
  "motion": {
    "duration":       { "$type": "duration", "$value": "160ms" },
    "duration-slide": { "$type": "duration", "$value": "340ms" },
    "easing":         { "$type": "cubicBezier", "$value": "cubic-bezier(0.2, 0.8, 0.2, 1)" },
    "easing-spring":  { "$type": "cubicBezier", "$value": "cubic-bezier(0.32, 0.72, 0, 1)" },
    "duration-press":   { "$type": "duration", "$value": "70ms", "$description": "Going in: press, check" },
    "duration-release": { "$type": "duration", "$value": "180ms", "$description": "Coming back: release, hover settle, pop" },
    "easing-press":   { "$type": "cubicBezier", "$value": "cubic-bezier(0.2, 0, 0, 1)" },
    "easing-release": { "$type": "cubicBezier", "$value": "cubic-bezier(0.2, 0.8, 0.2, 1)", "$description": "Precise: no overshoot anywhere" },
    "easing-pop":     { "$type": "cubicBezier", "$value": "cubic-bezier(0.2, 0.8, 0.2, 1)", "$description": "Check marks and radio dots appearing" },
    "duration-enter": { "$type": "duration", "$value": "380ms", "$description": "Page-load entrance (a quick, precise fade-up)" },
    "stagger":        { "$type": "duration", "$value": "40ms", "$description": "Delay between siblings in an entrance" },
    "duration-snap":  { "$type": "duration", "$value": "180ms", "$description": "Overlays arriving (menus, palette, tooltips): short and exact" },
    "easing-snap":    { "$type": "cubicBezier", "$value": "cubic-bezier(0.16, 1, 0.3, 1)", "$description": "Fast out, damped in: arrives at speed and stops dead, no overshoot" },
    "duration-exit":  { "$type": "duration", "$value": "110ms", "$description": "Overlays leaving: quicker than they came" }
  }
}
