      "$value": "70ms"
    },
    "easing": {
      "$type": "cubicBezier",
      "$value": "cubic-bezier(0.22, 1, 0.36, 1)",
      "$description": "Liquid damping: fast start, long soft settle"
    },
    "easing-press": {
      "$type": "cubicBezier",
      "$value": "cubic-bezier(0.4, 0, 0.6, 1)"
    },
    "easing-draw": {
      "$type": "cubicBezier",
      "$value": "cubic-bezier(0.65, 0, 0.35, 1)"
    }
