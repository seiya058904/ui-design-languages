{
  "name": "ui-design-languages",
  "description": "Machine-readable index of the Style Packs in this repository. Each pack is self-contained: copy its folder or link its entry files. Paths are relative to the repository root; CDN base: https://cdn.jsdelivr.net/gh/seiya058904/ui-design-languages@main/",
  "license": "MIT",
  "stack": "HTML + CSS custom properties + optional vanilla JS. No build step, no runtime dependencies.",
  "tokenBuild": "node scripts/build-tokens.mjs [pack]",
  "visualCheck": "node scripts/snap.mjs [pack]",
  "packs": [
    {
      "id": "clay",
      "name": "Clay",
      "status": "stable",
      "summary": "Soft extruded clay on a matte grid board, mint accent, light and dark.",
      "prefix": "clay",
      "entry": {
        "css": "clay/css/clay.css",
        "js": "clay/js/clay.js"
      },
      "tokens": [
        "clay/tokens/tokens.json",
        "clay/tokens/tokens.dark.json"
      ],
      "variants": {
        "theme": [
          "light",
          "dark",
          "auto"
        ]
      },
      "fonts": [
        {
          "family": "Inter",
          "url": "https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap",
          "license": "OFL-1.1"
        }
      ],
      "pages": {
        "styleguide": "clay/index.html",
        "examples": [
          "clay/examples/dashboard.html",
          "clay/examples/landing.html"
        ]
      },
      "docs": {
        "design": "clay/DESIGN.md",
        "agents": "clay/AGENTS.md",
        "readme": "clay/README.md"
      }
    },
    {
      "id": "lilac",
      "name": "Lilac",
      "status": "stable",
      "summary": "Ivory component-study tiles, one glowing accent, editorial serif headlines.",
