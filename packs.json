{
  "name": "ui-design-languages",
  "description": "Machine-readable index of the Style Packs in this repository. Each pack is self-contained: copy its folder or link its entry files. Paths are relative to the repository root; CDN base: https://cdn.jsdelivr.net/gh/seiya058904/ui-design-languages@main/",
  "license": "MIT",
  "stack": "HTML + CSS custom properties + optional vanilla JS. No build step, no runtime dependencies.",
  "tokenBuild": "node scripts/build-tokens.mjs [pack]",
  "visualCheck": "node scripts/snap.mjs [pack]",
  "check": "node scripts/check.mjs [pack]",
  "scaffold": "node scripts/new-pack.mjs <id> <Name>",
  "siteFields": "pack.site drives the library website only (never the pack): dot = brand color; label = inline style for the pack name; root = the pack's type and color on a live stage; canvas / page = stage and canvas backgrounds; backdrop = {class|style} for the wall's single-language canvas (defaults to page); hooks = selectors whose markup needs js/<pack>.js; darkHint = how to switch to dark when the script owns the theme; tone = \"dark\" when the canvas is dark in every theme (dark-first packs: the wall switches its notes to light ink); wall = [component, demo] picks from components.html for the component wall.",
