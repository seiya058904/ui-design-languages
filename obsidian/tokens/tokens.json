    },
    "duration-trail": {
      "$type": "duration",
      "$value": "440ms",
      "$description": "Trailing edge: the indicator stretches like a drop, then gathers"
    },
    "duration-draw": {
      "$type": "duration",
      "$value": "1400ms",
      "$description": "Charts and rings draw themselves in"
    },
    "duration-enter": {
