      "$type": "duration",
      "$value": "420ms",
      "$description": "Power-on: modules settle into the panel"
    },
    "stagger": {
      "$type": "duration",
      "$value": "45ms"
    },
    "easing-press": {
      "$type": "cubicBezier",
      "$value": "cubic-bezier(0.55, 0, 1, 0.45)",
      "$description": "Accelerates into the stop"
    },
    "easing-release": {
      "$type": "cubicBezier",
      "$value": "cubic-bezier(0.2, 0, 0, 1)",
      "$description": "Decelerates home; never overshoots"
    },
    "easing-snap": {
      "$type": "cubicBezier",
      "$value": "cubic-bezier(0.7, 0, 0.25, 1)",
      "$description": "Spring-loaded over-centre switch: resists, then snaps"
    },
    "easing-travel": {
      "$type": "cubicBezier",
      "$value": "cubic-bezier(0.45, 0, 0.2, 1)",
      "$description": "A motor-driven needle"
    },
    "easing-fill": {
      "$type": "cubicBezier",
      "$value": "linear"
    }
  }
}
