  "atmosphere": {
    "page": {
      "$type": "string",
      "$value": "radial-gradient(1100px 620px at 8% -12%, color-mix(in srgb, var(--obsidian-color-primary) 15%, transparent), transparent 62%), radial-gradient(900px 560px at 100% -6%, color-mix(in srgb, var(--obsidian-color-primary) 9%, transparent), transparent 58%), radial-gradient(1000px 700px at 50% 115%, rgba(16, 185, 129, 0.05), transparent 60%)",
      "$description": "The deep-space air behind the glass: a cold light from the top corners, a faint green floor glow"
    },
    "sheen": {
      "$type": "string",
      "$value": "linear-gradient(180deg, rgba(255, 255, 255, 0.045), rgba(255, 255, 255, 0.008) 42%, rgba(255, 255, 255, 0))",
      "$description": "Light falling across a glass face, top to bottom"
