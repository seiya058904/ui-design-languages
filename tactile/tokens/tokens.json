{
  "$description": "Tactile design tokens — warm sand neumorphism. Every surface is the same material as the page; depth comes from a paired highlight (top-left) and shade (bottom-right). Shadow tokens reference --tactile-color-light / --tactile-color-dark, so a tone variant only swaps colors. Build with `node scripts/build-tokens.mjs tactile`.",
  "color": {
    "surface": {
      "$type": "color",
      "$value": "#EEE6D9",
      "$description": "The material: page and every raised piece"
    },
    "surface-pressed": {
      "$type": "color",
      "$value": "#E5DACA",
      "$description": "Pressed pieces sink and darken"
    },
    "well": {
      "$type": "color",
      "$value": "#E9E0D2",
      "$description": "Inset fields and tracks"
    },
    "light": {
      "$type": "color",
      "$value": "rgba(255, 253, 249, 0.95)",
      "$description": "Highlight half of every shadow"
    },
    "dark": {
      "$type": "color",
      "$value": "rgba(160, 132, 94, 0.52)",
      "$description": "Shade half of every shadow"
    },
    "dark-soft": {
      "$type": "color",
      "$value": "rgba(160, 132, 94, 0.32)",
      "$description": "Shade for low levels"
    },
    "line": {
      "$type": "color",
      "$value": "#DCD0BD",
      "$description": "Hairlines and section rules"
    },
    "primary": {
      "$type": "color",
      "$value": "#0E5357",
      "$description": "Deep teal — the accent"
    },
    "primary-strong": {
      "$type": "color",
      "$value": "#093D40",
      "$description": "Pressed teal"
    },
    "primary-light": {
      "$type": "color",
      "$value": "#1A6B70",
      "$description": "Top of teal gradients"
    },
    "primary-ink": {
      "$type": "color",
      "$value": "#F2FAF9",
      "$description": "Text on teal"
    },
    "primary-soft": {
      "$type": "color",
      "$value": "#D8E2DA",
      "$description": "Teal wash (selected rows)"
    },
    "glow": {
      "$type": "color",
      "$value": "rgba(14, 83, 87, 0.32)",
      "$description": "Teal cast shadow and focus bloom"
    },
    "ink": {
      "$type": "color",
      "$value": "#1C2828",
      "$description": "Headings"
    },
    "text": {
      "$type": "color",
      "$value": "#2D3635",
      "$description": "Body text"
    },
    "text-muted": {
      "$type": "color",
      "$value": "#6A665D",
      "$description": "Secondary text (≥ 4.5:1 on sand)"
    },
    "text-subtle": {
      "$type": "color",
      "$value": "#9F978A",
      "$description": "Placeholders, ticks"
    },
    "danger": {
      "$type": "color",
      "$value": "#BC4339"
    },
    "danger-soft": {
      "$type": "color",
      "$value": "#F1DBD3"
    },
    "warning": {
      "$type": "color",
      "$value": "#A8761F"
    },
    "warning-soft": {
      "$type": "color",
      "$value": "#F1E3C6"
    },
    "tip": {
      "$type": "color",
      "$value": "#2F3231",
      "$description": "Tooltip and value bubbles"
    },
    "tip-ink": {
      "$type": "color",
      "$value": "#F4EFE7"
    },
    "skeleton": {
      "$type": "color",
      "$value": "#DBCFBC"
    },
    "disabled": {
      "$type": "color",
      "$value": "#DED5C7"
    },
    "disabled-ink": {
      "$type": "color",
      "$value": "#A39A8C"
    },
    "annotation": {
      "$type": "color",
      "$value": "#3E7BD8",
      "$description": "Spec callouts (dots and dashed leaders)"
    },
    "backdrop": {
      "$type": "color",
      "$value": "rgba(60, 48, 30, 0.3)"
    }
  },
  "font": {
    "family": {
      "sans": {
        "$type": "fontFamily",
        "$value": "\"Plus Jakarta Sans\", \"Avenir Next\", \"Segoe UI\", system-ui, sans-serif"
      }
    },
    "size": {
      "display": {
        "$type": "dimension",
        "$value": "40px"
      },
      "title": {
        "$type": "dimension",
        "$value": "24px"
      },
      "section": {
        "$type": "dimension",
        "$value": "15px"
      },
      "heading": {
        "$type": "dimension",
        "$value": "17px"
      },
      "body": {
        "$type": "dimension",
        "$value": "14px"
      },
      "small": {
        "$type": "dimension",
        "$value": "13px"
      },
      "caption": {
        "$type": "dimension",
        "$value": "12px"
      },
      "label": {
        "$type": "dimension",
        "$value": "11px"
      }
    },
    "weight": {
      "regular": {
        "$type": "fontWeight",
        "$value": "400"
      },
      "medium": {
        "$type": "fontWeight",
        "$value": "500"
      },
      "semibold": {
        "$type": "fontWeight",
        "$value": "600"
      },
      "bold": {
        "$type": "fontWeight",
        "$value": "700"
      },
      "black": {
        "$type": "fontWeight",
        "$value": "800"
      }
    }
  },
  "space": {
    "1": {
      "$type": "dimension",
      "$value": "4px"
    },
    "2": {
      "$type": "dimension",
      "$value": "8px"
    },
    "3": {
      "$type": "dimension",
      "$value": "12px"
    },
    "4": {
      "$type": "dimension",
      "$value": "16px"
    },
    "5": {
      "$type": "dimension",
      "$value": "20px"
    },
    "6": {
      "$type": "dimension",
      "$value": "24px"
    },
    "8": {
      "$type": "dimension",
      "$value": "32px"
    },
    "10": {
      "$type": "dimension",
      "$value": "40px"
    }
  },
  "radius": {
    "xs": {
      "$type": "dimension",
      "$value": "4px"
    },
    "sm": {
      "$type": "dimension",
      "$value": "8px",
      "$description": "Fields, tags"
    },
    "md": {
      "$type": "dimension",
      "$value": "12px",
      "$description": "Buttons, list items"
    },
    "lg": {
      "$type": "dimension",
      "$value": "16px",
      "$description": "Cards"
    },
    "xl": {
      "$type": "dimension",
      "$value": "24px",
      "$description": "Panels, dialogs, layer tiles"
    },
    "pill": {
      "$type": "dimension",
      "$value": "999px",
      "$description": "Toggles, steps, badges"
    }
  },
  "border": {
    "thin": {
      "$type": "dimension",
      "$value": "1px"
    },
    "regular": {
      "$type": "dimension",
      "$value": "2px"
    },
    "thick": {
      "$type": "dimension",
      "$value": "4px"
    }
  },
  "size": {
    "control-sm": {
      "$type": "dimension",
      "$value": "32px"
    },
    "control": {
      "$type": "dimension",
      "$value": "42px"
    },
    "control-lg": {
      "$type": "dimension",
      "$value": "48px"
    }
  },
  "shadow": {
    "level-1": {
      "$type": "shadow",
      "$value": "-1px -1px 2px var(--tactile-color-light), 1px 1px 3px var(--tactile-color-dark-soft)",
      "$description": "Flat"
    },
    "level-2": {
      "$type": "shadow",
      "$value": "-3px -3px 7px var(--tactile-color-light), 3px 3px 8px var(--tactile-color-dark-soft)",
      "$description": "Hover"
    },
    "level-3": {
      "$type": "shadow",
      "$value": "-7px -7px 16px var(--tactile-color-light), 8px 8px 18px var(--tactile-color-dark)",
      "$description": "Raised"
    },
    "level-4": {
      "$type": "shadow",
      "$value": "-10px -10px 24px var(--tactile-color-light), 10px 12px 26px var(--tactile-color-dark)",
      "$description": "Modal"
    },
    "level-5": {
      "$type": "shadow",
      "$value": "-16px -16px 36px var(--tactile-color-light), 16px 18px 40px var(--tactile-color-dark)",
      "$description": "Popover"
    },
    "inset": {
      "$type": "shadow",
      "$value": "inset 4px 4px 9px var(--tactile-color-dark), inset -4px -4px 9px var(--tactile-color-light)",
      "$description": "Carved fields and tracks"
    },
    "inset-sm": {
      "$type": "shadow",
      "$value": "inset 2px 2px 4px var(--tactile-color-dark-soft), inset -2px -2px 4px var(--tactile-color-light)"
    },
    "pressed": {
      "$type": "shadow",
      "$value": "inset 6px 6px 13px var(--tactile-color-dark), inset -5px -5px 12px var(--tactile-color-light)",
      "$description": "Pushed-in pieces"
    },
    "accent": {
      "$type": "shadow",
      "$value": "-4px -4px 10px var(--tactile-color-light), 5px 6px 14px var(--tactile-color-glow), inset 0 1px 0 rgba(255, 255, 255, 0.14)",
      "$description": "Teal pieces cast a teal shadow"
    },
    "focus": {
      "$type": "shadow",
      "$value": "0 0 0 2px var(--tactile-color-primary-light), 0 0 12px 2px var(--tactile-color-glow)"
    }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "$value": "180ms"
    },
    "duration-slide": {
      "$type": "duration",
      "$value": "360ms"
    },
    "easing": {
      "$type": "cubicBezier",
      "$value": "cubic-bezier(0.2, 0.8, 0.2, 1)"
    },
    "easing-spring": {
      "$type": "cubicBezier",
      "$value": "cubic-bezier(0.32, 0.72, 0, 1)"
    }
  }
}
