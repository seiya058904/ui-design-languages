  "motion": {
    "duration-press": {
      "$type": "duration",
      "$value": "55ms",
      "$description": "A key bottoms out: one crisp detent"
    },
    "duration-release": {
      "$type": "duration",
      "$value": "140ms",
      "$description": "The spring returns it — fast, no overshoot"
    },
    "duration-detent": {
      "$type": "duration",
      "$value": "55ms",
      "$description": "The dial clicks from one step to the next"
    },
    "duration-snap": {
      "$type": "duration",
      "$value": "120ms",
      "$description": "Toggle knob snapping over centre"
    },
    "duration-travel": {
