    "track": {
      "$type": "color",
      "$value": "rgba(255, 255, 255, 0.09)",
      "$description": "Unfilled tracks: slider, switch off, rings"
    },
    "knob": {
      "$type": "color",
      "$value": "#E9EEF4",
      "$description": "Switch and slider knobs"
