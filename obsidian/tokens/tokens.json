  "shadow": {
    "panel": {
      "$type": "shadow",
      "$value": "inset 0 1px 0 var(--obsidian-color-edge), 0 24px 48px -24px rgba(0, 0, 0, 0.7)",
      "$description": "Frosted panels and cards: a specular top edge over a deep ambient shadow"
    },
    "elevated": {
      "$type": "shadow",
      "$value": "inset 0 1px 0 var(--obsidian-color-edge-hover), 0 2px 6px rgba(0, 0, 0, 0.3), 0 30px 60px -22px rgba(0, 0, 0, 0.8)",
      "$description": "Popovers, dialogs, toasts"
    },
    "inset": {
      "$type": "shadow",
      "$value": "inset 0 2px 6px rgba(0, 0, 0, 0.45), inset 0 0 0 1px rgba(255, 255, 255, 0.035)",
      "$description": "Inner depth: tracks, fields, wells"
    },
    "control": {
      "$type": "shadow",
      "$value": "inset 0 1px 0 var(--obsidian-color-edge), 0 1px 2px rgba(0, 0, 0, 0.35)",
      "$description": "Glass controls at rest"
    },
    "glow": {
      "$type": "shadow",
      "$value": "inset 0 1px 0 rgba(255, 255, 255, 0.35), 0 0 0 1px var(--obsidian-color-border-high), 0 0 16px -2px var(--obsidian-color-primary-glow), 0 6px 18px -8px var(--obsidian-color-primary-glow)",
      "$description": "A lit primary piece"
    },
    "glow-hover": {
      "$type": "shadow",
      "$value": "inset 0 1px 0 rgba(255, 255, 255, 0.45), 0 0 0 1px var(--obsidian-color-primary), 0 0 22px 0 var(--obsidian-color-primary-glow), 0 8px 24px -8px var(--obsidian-color-primary-glow)",
      "$description": "The bloom widens under the pointer"
    },
    "glow-pressed": {
      "$type": "shadow",
      "$value": "inset 0 1px 2px rgba(0, 0, 0, 0.22), 0 0 0 1px var(--obsidian-color-primary-strong), 0 0 8px -2px var(--obsidian-color-primary-glow), 0 2px 8px -6px var(--obsidian-color-primary-glow)",
      "$description": "Pressed: the light pulls in"
    },
    "focus": {
      "$type": "shadow",
      "$value": "0 0 0 1px var(--obsidian-color-primary), 0 0 0 4px var(--obsidian-color-primary-soft), 0 0 18px -2px var(--obsidian-color-primary-glow)"
    }
  },
