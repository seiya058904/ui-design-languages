{
  "$description": "Lilac at night (added; the references are light only). Ink-violet tiles, ivory type, and a brighter violet whose glow carries more on a dark ground. Opt in with <html data-theme=\"dark\"> or follow the OS with data-theme=\"auto\".",
  "color": {
    "canvas":         { "$value": "#121118" },
    "tile":           { "$value": "#1A1922" },
    "surface":        { "$value": "#23222C" },
    "surface-sunken": { "$value": "#16151C" },
    "track":          { "$value": "#302E3A" },
    "knob":           { "$value": "#EEEBF4" },
    "primary":        { "$value": "#6E50F4", "$description": "White labels stay ≥ 5:1; the glow does the brightening" },
    "primary-hover":  { "$value": "#7A5DFA" },
    "primary-light":  { "$value": "#8C72FF" },
    "primary-soft":   { "$value": "#B9A6FF" },
    "primary-wash":   { "$value": "#2A2342" },
    "on-wash":        { "$value": "#CDBFFF" },
    "glow":           { "$value": "rgba(123, 92, 255, 0.55)" },
    "glow-soft":      { "$value": "rgba(123, 92, 255, 0.24)" },
    "ink":            { "$value": "#F4F1EA" },
    "text":           { "$value": "#E6E3EC" },
    "text-muted":     { "$value": "#A7A4B3" },
    "text-subtle":    { "$value": "#75727F" },
    "hairline":       { "$value": "rgba(255, 255, 255, 0.08)" },
    "control-edge":   { "$value": "rgba(255, 255, 255, 0.16)" },
    "edge":           { "$value": "rgba(255, 255, 255, 0.06)" },
    "disabled":       { "$value": "#25242D" },
    "disabled-ink":   { "$value": "#625F6D" },
    "success":        { "$value": "#15302A" },
    "success-ink":    { "$value": "#86D9B6" },
    "warning":        { "$value": "#33291A" },
    "warning-ink":    { "$value": "#EAC47C" },
    "error":          { "$value": "#3A1F23" },
    "error-ink":      { "$value": "#F3A6A3" },
    "backdrop":       { "$value": "rgba(6, 5, 12, 0.62)" }
  },
  "shadow": {
    "tile":         { "$value": "inset 0 1px 0 rgba(255, 255, 255, 0.05), 0 1px 2px rgba(0, 0, 0, 0.3), 0 18px 40px -16px rgba(0, 0, 0, 0.65)" },
    "raised":       { "$value": "inset 0 1px 0 rgba(255, 255, 255, 0.07), 0 1px 2px rgba(0, 0, 0, 0.35), 0 10px 22px -8px rgba(0, 0, 0, 0.6)" },
    "raised-hover": { "$value": "inset 0 1px 0 rgba(255, 255, 255, 0.09), 0 2px 4px rgba(0, 0, 0, 0.35), 0 16px 30px -10px rgba(0, 0, 0, 0.7)" },
    "pressed":      { "$value": "inset 0 2px 5px rgba(0, 0, 0, 0.45), 0 0 0 transparent, 0 0 0 transparent, inset 0 -1px 0 rgba(255, 255, 255, 0.05)" },
    "inset":        { "$value": "inset 0 1px 3px rgba(0, 0, 0, 0.5), inset 0 -1px 0 rgba(255, 255, 255, 0.04)" },
    "accent":       { "$value": "inset 0 1px 0 rgba(255, 255, 255, 0.22), 0 2px 8px rgba(123, 92, 255, 0.35), 0 14px 32px -8px rgba(123, 92, 255, 0.6)" },
    "accent-hover": { "$value": "inset 0 1px 0 rgba(255, 255, 255, 0.25), 0 3px 10px rgba(123, 92, 255, 0.4), 0 20px 40px -10px rgba(123, 92, 255, 0.7)" },
    "knob":         { "$value": "0 1px 1px rgba(0, 0, 0, 0.3), 0 3px 8px rgba(0, 0, 0, 0.45)" },
    "focus":        { "$value": "0 0 0 3px rgba(123, 92, 255, 0.42)" },
    "float":        { "$value": "inset 0 1px 0 rgba(255, 255, 255, 0.06), 0 4px 10px rgba(0, 0, 0, 0.35), 0 30px 60px -20px rgba(0, 0, 0, 0.75)" }
  }
}
