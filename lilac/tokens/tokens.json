{
  "$description": "Lilac design tokens — single source of truth. Ivory component-study tiles, one saturated accent with a soft glow, editorial serif headlines. Build with `node scripts/build-tokens.mjs lilac` from the repo root.",
  "color": {
    "canvas":         { "$type": "color", "$value": "#F3F0EA", "$description": "Page behind the tiles" },
    "tile":           { "$type": "color", "$value": "#FAF8F4", "$description": "Component-study tiles and cards" },
    "surface":        { "$type": "color", "$value": "#FCFAF6", "$description": "Raised ivory: secondary buttons, search pill, knobs (printed on the reference)" },
    "surface-sunken": { "$type": "color", "$value": "#EEEAE3", "$description": "Tracks and wells" },
    "track":          { "$type": "color", "$value": "#E2DED7", "$description": "Off toggle, empty slider and ring track" },
    "primary":        { "$type": "color", "$value": "#5B2DFF", "$description": "Violet — the single accent" },
    "primary-hover":  { "$type": "color", "$value": "#4C1EF2", "$description": "Pressed / hover violet" },
    "primary-light":  { "$type": "color", "$value": "#7C55FF", "$description": "Top of primary gradients" },
    "primary-soft":   { "$type": "color", "$value": "#C8B4FF", "$description": "Lilac — secondary accent, slider knob, icon discs" },
    "primary-wash":   { "$type": "color", "$value": "#EFE9FF", "$description": "Selected tab, icon backgrounds" },
    "primary-ink":    { "$type": "color", "$value": "#FFFFFF", "$description": "Text on violet" },
    "on-wash":        { "$type": "color", "$value": "#4320D6", "$description": "Text on lilac wash" },
    "glow":           { "$type": "color", "$value": "rgba(91, 45, 255, 0.45)", "$description": "Accent glow" },
    "glow-soft":      { "$type": "color", "$value": "rgba(91, 45, 255, 0.18)", "$description": "Focus halo" },
    "ink":            { "$type": "color", "$value": "#1F1F28", "$description": "Ink swatch, headlines" },
    "text":           { "$type": "color", "$value": "#24232D", "$description": "Body text" },
    "text-muted":     { "$type": "color", "$value": "#6E6C78", "$description": "Secondary text (≥ 4.5:1 on tile)" },
    "text-subtle":    { "$type": "color", "$value": "#A5A2AC", "$description": "Placeholder, eyebrow numbers" },
    "hairline":       { "$type": "color", "$value": "rgba(36, 35, 45, 0.08)", "$description": "Dividers inside tiles" },
    "control-edge":   { "$type": "color", "$value": "rgba(36, 35, 45, 0.18)", "$description": "Outline of unchecked checkboxes and radios" },
    "edge":           { "$type": "color", "$value": "rgba(255, 255, 255, 0.9)", "$description": "Bright top edge on raised ivory" },
    "disabled":       { "$type": "color", "$value": "#ECE9E3" },
    "disabled-ink":   { "$type": "color", "$value": "#B3B0B8" },
    "success":        { "$type": "color", "$value": "#E3F4EC" },
    "success-ink":    { "$type": "color", "$value": "#1D6A4E" },
    "warning":        { "$type": "color", "$value": "#FBF0D9" },
    "warning-ink":    { "$type": "color", "$value": "#7A5A13" },
    "error":          { "$type": "color", "$value": "#FCE6E5" },
    "error-ink":      { "$type": "color", "$value": "#9E2D2B" },
    "backdrop":       { "$type": "color", "$value": "rgba(40, 34, 60, 0.28)" }
  },
  "font": {
    "family": {
      "serif": { "$type": "fontFamily", "$value": "\"Cormorant Garamond\", \"Cormorant\", Garamond, \"Times New Roman\", serif", "$description": "Display, numerals, headlines" },
      "sans":  { "$type": "fontFamily", "$value": "\"Manrope\", \"Avenir Next\", \"Segoe UI\", system-ui, sans-serif", "$description": "Interface text" }
    },
    "size": {
      "display":  { "$type": "dimension", "$value": "72px" },
      "heading":  { "$type": "dimension", "$value": "48px" },
      "title":    { "$type": "dimension", "$value": "34px" },
      "subtitle": { "$type": "dimension", "$value": "22px" },
      "body":     { "$type": "dimension", "$value": "16px" },
      "small":    { "$type": "dimension", "$value": "13px" },
      "caption":  { "$type": "dimension", "$value": "12px" },
      "eyebrow":  { "$type": "dimension", "$value": "13px" }
    },
    "weight": {
      "light":    { "$type": "fontWeight", "$value": "300" },
      "regular":  { "$type": "fontWeight", "$value": "400" },
      "medium":   { "$type": "fontWeight", "$value": "500" },
      "semibold": { "$type": "fontWeight", "$value": "600" },
      "bold":     { "$type": "fontWeight", "$value": "700" }
    },
    "tracking": {
      "eyebrow": { "$type": "dimension", "$value": "0.28em", "$description": "Spaced small-caps labels" },
      "display": { "$type": "dimension", "$value": "0.04em", "$description": "Serif caps titles" },
      "tight":   { "$type": "dimension", "$value": "-0.01em" }
    }
  },
  "space": {
    "1":  { "$type": "dimension", "$value": "4px" },
    "2":  { "$type": "dimension", "$value": "8px" },
    "3":  { "$type": "dimension", "$value": "12px" },
    "4":  { "$type": "dimension", "$value": "16px" },
    "5":  { "$type": "dimension", "$value": "20px" },
    "6":  { "$type": "dimension", "$value": "24px" },
    "8":  { "$type": "dimension", "$value": "32px" },
    "10": { "$type": "dimension", "$value": "40px" },
    "12": { "$type": "dimension", "$value": "48px" },
    "16": { "$type": "dimension", "$value": "64px" }
  },
  "radius": {
    "sm":   { "$type": "dimension", "$value": "9px",  "$description": "Checkboxes" },
    "md":   { "$type": "dimension", "$value": "16px", "$description": "Inner cards, list items" },
    "lg":   { "$type": "dimension", "$value": "24px", "$description": "Tiles" },
    "xl":   { "$type": "dimension", "$value": "32px", "$description": "Dialogs, hero panels" },
    "pill": { "$type": "dimension", "$value": "999px", "$description": "Buttons, fields, toggles, tabs" }
  },
  "size": {
    "control-sm": { "$type": "dimension", "$value": "36px" },
    "control":    { "$type": "dimension", "$value": "48px" },
    "control-lg": { "$type": "dimension", "$value": "64px" }
  },
  "shadow": {
    "tile":       { "$type": "shadow", "$value": "inset 0 1px 0 rgba(255, 255, 255, 0.9), 0 1px 2px rgba(60, 50, 40, 0.04), 0 14px 34px -14px rgba(60, 50, 40, 0.16)", "$description": "Study tiles" },
    "raised":     { "$type": "shadow", "$value": "inset 0 1px 0 rgba(255, 255, 255, 1), 0 1px 2px rgba(60, 50, 40, 0.06), 0 8px 18px -8px rgba(60, 50, 40, 0.22)", "$description": "Ivory pieces that sit on a tile" },
    "raised-hover": { "$type": "shadow", "$value": "inset 0 1px 0 rgba(255, 255, 255, 1), 0 2px 4px rgba(60, 50, 40, 0.06), 0 14px 26px -10px rgba(60, 50, 40, 0.26)" },
    "pressed":    { "$type": "shadow", "$value": "inset 0 2px 5px rgba(60, 50, 40, 0.14), 0 0 0 transparent, 0 0 0 transparent, inset 0 -1px 0 rgba(255, 255, 255, 0.8)", "$description": "Same list shape as raised (inset, outer, outer) so pressing sinks smoothly instead of snapping" },
    "inset":      { "$type": "shadow", "$value": "inset 0 1px 3px rgba(60, 50, 40, 0.12), inset 0 -1px 0 rgba(255, 255, 255, 0.7)", "$description": "Tracks and wells" },
    "accent":     { "$type": "shadow", "$value": "inset 0 1px 0 rgba(255, 255, 255, 0.28), 0 2px 6px rgba(91, 45, 255, 0.25), 0 12px 26px -8px rgba(91, 45, 255, 0.55)", "$description": "Violet pieces glow onto the ivory" },
    "accent-hover": { "$type": "shadow", "$value": "inset 0 1px 0 rgba(255, 255, 255, 0.3), 0 3px 8px rgba(91, 45, 255, 0.3), 0 18px 34px -10px rgba(91, 45, 255, 0.6)" },
    "knob":       { "$type": "shadow", "$value": "0 1px 1px rgba(30, 20, 60, 0.1), 0 3px 8px rgba(30, 20, 60, 0.2)", "$description": "Toggle and slider knobs" },
    "focus":      { "$type": "shadow", "$value": "0 0 0 3px rgba(91, 45, 255, 0.22)", "$description": "Focus halo (append)" },
    "float":      { "$type": "shadow", "$value": "inset 0 1px 0 rgba(255, 255, 255, 0.9), 0 4px 10px rgba(60, 50, 40, 0.06), 0 30px 60px -20px rgba(60, 50, 40, 0.3)", "$description": "Dialogs, toasts" }
  },
  "motion": {
    "duration":       { "$type": "duration", "$value": "200ms" },
    "duration-slide": { "$type": "duration", "$value": "380ms" },
    "easing":         { "$type": "cubicBezier", "$value": "cubic-bezier(0.2, 0.8, 0.2, 1)" },
    "easing-spring":  { "$type": "cubicBezier", "$value": "cubic-bezier(0.32, 0.72, 0, 1)" },
    "duration-press":   { "$type": "duration", "$value": "140ms", "$description": "Going in: press, check" },
    "duration-release": { "$type": "duration", "$value": "380ms", "$description": "Coming back: release, hover settle, pop" },
    "easing-press":   { "$type": "cubicBezier", "$value": "cubic-bezier(0.4, 0, 0.6, 1)" },
    "easing-release": { "$type": "cubicBezier", "$value": "cubic-bezier(0.22, 1.25, 0.36, 1)", "$description": "Soft settle: pieces float back with a gentle overshoot" },
    "easing-pop":     { "$type": "cubicBezier", "$value": "cubic-bezier(0.22, 1.35, 0.36, 1)", "$description": "Check marks and radio dots appearing" }
  }
}
