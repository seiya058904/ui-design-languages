{
  "$description": "Obsidian / Glass design tokens — dark first. A deep obsidian canvas under a faint cyan atmosphere; four layers of glass (base, frosted, elevated, inset) edged with 1px specular light; one luminous accent. Glows, washes and the high border are mixed from --obsidian-color-primary, so an accent variant (tokens.accent-*.json) only swaps three colors. Build with `node scripts/build-tokens.mjs obsidian`.",
  "color": {
    "canvas": {
      "$type": "color",
      "$value": "#0B0D12",
      "$description": "Obsidian — the page"
    },
    "surface": {
      "$type": "color",
      "$value": "#151922",
      "$description": "Base: solid glass"
    },
    "glass": {
      "$type": "color",
      "$value": "rgba(22, 27, 37, 0.6)",
      "$description": "Frosted: 60% over a 12px blur"
    },
    "glass-elevated": {
      "$type": "color",
      "$value": "rgba(28, 34, 46, 0.8)",
      "$description": "Elevated: 80% over a 16px blur — popovers, dialogs, toasts"
    },
    "glass-inset": {
      "$type": "color",
      "$value": "rgba(3, 5, 9, 0.4)",
      "$description": "Inset: inner depth, 40% — tracks, wells, fields"
    },
    "field": {
      "$type": "color",
      "$value": "rgba(6, 9, 14, 0.55)",
      "$description": "Text fields"
    },
    "hover": {
      "$type": "color",
      "$value": "rgba(255, 255, 255, 0.05)",
      "$description": "Wash under the pointer (rows, items, ghost buttons)"
    },
    "control": {
      "$type": "color",
      "$value": "rgba(255, 255, 255, 0.065)",
      "$description": "Glass controls: secondary buttons, keys, chips"
    },
    "control-hover": {
      "$type": "color",
      "$value": "rgba(255, 255, 255, 0.1)"
    },
    "border-high": {
      "$type": "color",
      "$value": "color-mix(in srgb, var(--obsidian-color-primary) 72%, transparent)",
      "$description": "1px · High (primary): focus, selection, the primary action"
    },
    "border-medium": {
      "$type": "color",
      "$value": "rgba(255, 255, 255, 0.14)",
      "$description": "1px · Medium: controls, elevated glass, hover"
    },
    "border-low": {
      "$type": "color",
      "$value": "rgba(255, 255, 255, 0.075)",
      "$description": "1px · Low: panels and cards at rest"
    },
    "edge": {
      "$type": "color",
      "$value": "rgba(255, 255, 255, 0.12)",
      "$description": "Specular top edge of every glass layer"
    },
    "edge-hover": {
      "$type": "color",
      "$value": "rgba(255, 255, 255, 0.24)",
      "$description": "The edge catching more light under the pointer"
    },
    "ink": {
      "$type": "color",
      "$value": "#F1F5F9",
      "$description": "Ink: headings and values"
